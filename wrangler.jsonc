// ÉKA Semijoias: one Worker serves the SPA (static assets), the API, uploaded
// photos and the live WebSocket. See docs/backend/PLAN.md and AGENTS.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eka-semijoias",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  // Smaller script → faster cold starts.
  "minify": true,
  // Version preview URLs would run against the production database and secrets.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Page routes (/, /catalogo, /produto/…, /admin…) run the Worker so index.html gets a CSP naming
    // this host's WebSocket; static files below skip it (served straight from the edge, not metered).
    // /assets/* runs the Worker too: it marks a hashed file immutable only when it exists, so a 404 seen
    // during a deploy rollout is never cached for a year (that blanked the site once). Repeat requests
    // for an existing file are answered by Workers Caching without running the Worker.
    "run_worker_first": [
      "/*",
      "!/images/*",
      "!/brand/*",
      "!/favicon.svg",
      "!/favicon-32.png",
      "!/favicon-192.png",
      "!/favicon-512.png",
      "!/apple-touch-icon.png",
      "!/icon-maskable-512.png",
      "!/manifest.webmanifest",
      "!/admin.webmanifest",
      "!/revenda.webmanifest",
      "!/admin-icon-192.png",
      "!/admin-icon-512.png",
      "!/admin-icon-maskable-512.png",
      "!/admin-apple-touch-icon.png",
      "!/admin-badge-96.png",
      "!/sw.js",
      "!/og-image.jpg",
      "!/robots.txt"
    ]
  },
  // Workers Caching: immutable responses (photos, versioned catalogs) are answered
  // from the edge without running the Worker. Driven by each response's Cache-Control.
  "cache": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eka-semijoias",
      "database_id": "b543ab66-fda4-41d7-b75b-6fcf6ff51d8a",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Daily at 07:00 UTC (03:00 in Cuiabá): erases receipt files 7 days after the payment (worker/payments.ts).
  "triggers": { "crons": ["0 7 * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],
  // Our own structured logs (no IPs, cookies or bodies); automatic per-request logs are off for privacy.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
