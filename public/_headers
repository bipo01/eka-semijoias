# Headers for static assets (Workers Static Assets). The Worker sets its own on
# /api/*, /media/* and the document at "/" (whose CSP also names the WebSocket host).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Hashed build output never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and brand files keep their names across deploys: cache a day, refresh in the background.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The service worker (install + push only, no caching): always revalidate so a deploy reaches every device.
/sw.js
  Cache-Control: no-cache
